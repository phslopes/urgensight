# Secrets
.env
.env.*
*.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# Data (regenerable via `dvc repro` -- as pastas agora sao outs do DVC,
# que gerencia seu proprio .gitignore interno; os antigos .gitkeep saíram
# do Git em favor do dvc.yaml/dvc.lock)
data/raw/*
data/processed/*

# DVC: remote local e cache (os metadados .dvc/ e dvc.lock vao para o Git)
.dvcstore/
/.dvc/cache
/.dvc/tmp

# Models (regenerable via src/train.py or the Airflow DAG)
models/*.pkl
models/history/
!models/.gitkeep

# Airflow (docker-compose.yml)
airflow_logs/

# Knowledge Graph (mantem artefatos principais, ignora cache)
graphify-out/

# OS / editors
.DS_Store
.vscode/
*.log
